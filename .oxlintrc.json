{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "ignoreElements": ["td"]
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist/**", "src/web/routeTree.gen.ts"]
}
