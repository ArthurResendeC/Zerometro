# Copie para .env e preencha. Padrões de DATABASE_PATH, TZ e PORT ficam no mise.toml.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Conquistas (opcionais; sem a chave, a fonte some da interface)
# Steam: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# RetroAchievements: https://retroachievements.org/settings (seção Keys)
RA_API_KEY=

# Token do admin desta instância: entra no site como admin (os amigos entram com @apelido e
# senha, por convite), aprova conectores MCP (claude.ai) e vale como Bearer na API e no /mcp.
# Pelo menos 32 caracteres. Gere com: mise run token >> .env
ZEROMETRO_TOKEN=
# Chave que assina os logins e os conectores MCP (opcional; gere com: openssl rand -hex 32).
# Sem ela, vem do ZEROMETRO_TOKEN, e trocar o token desloga todo mundo e desconecta os conectores.
# Trocar a SESSION_SECRET desloga todo mundo.
# SESSION_SECRET=
# URL pública do site (padrão: domínio da Railway ou http://localhost:$PORT)
# PUBLIC_URL=https://zerometro.exemplo.com

# Deploy (Railway): lidas pelo .railway/railway.ts no `mise run deploy:plan`/`deploy:apply`,
# não pelo servidor. Cada instância tem as suas.
# Domínio próprio (opcional; sem ele, use o gerado por `railway domain`). Também vira a PUBLIC_URL.
# ZEROMETRO_DOMAIN=zerometro.exemplo.com
# Região do volume do SQLite (padrão: us-west2). Precisa bater com a de um volume que já existe.
# ZEROMETRO_VOLUME_REGION=us-west2
# Backup do SQLite (Litestream): railway (padrão) cria um bucket da Railway e liga as BACKUP_*;
# externo usa um R2 ou outro S3 com as BACKUP_* definidas à mão na Railway; desligado não faz backup.
# ZEROMETRO_BACKUP=railway
# Região do bucket da Railway (sjc, iad, ams ou sin; padrão iad). Não muda depois de criado.
# ZEROMETRO_BACKUP_REGION=iad
