# Copie para .env e preencha. Padrões de DATABASE_PATH, TZ e PORT ficam no mise.toml.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Token de acesso desta instância: entra no site, aprova conectores MCP (claude.ai) e vale como
# Bearer na API e no /mcp. Pelo menos 32 caracteres. Gere com: mise run token >> .env
# Trocar o token desloga todos os aparelhos e desconecta todos os conectores.
ZEROMETRO_TOKEN=
# URL pública do site (padrão: domínio da Railway ou http://localhost:$PORT)
# PUBLIC_URL=https://zerometro.exemplo.com

# Deploy (Railway): lidas pelo .railway/railway.ts no `mise run deploy:plan`/`deploy:apply`,
# não pelo servidor. Cada instância tem as suas.
# Domínio próprio (opcional; sem ele, use o gerado por `railway domain`). Também vira a PUBLIC_URL.
# ZEROMETRO_DOMAIN=zerometro.exemplo.com
# Região do volume do SQLite (padrão: us-west2). Precisa bater com a de um volume que já existe.
# ZEROMETRO_VOLUME_REGION=us-west2
