# Copie para .env e preencha. Padrões de DATABASE_PATH, TZ e PORT ficam no mise.toml.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Login (Better Auth + Google): https://console.cloud.google.com → Google Auth Platform → Clients
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do site (padrão: http://localhost:$PORT)
# BETTER_AUTH_URL=https://zerometro.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails convidados, separados por vírgula; o primeiro é o dono
ALLOWED_EMAILS=

# Deploy (Railway): lidas pelo .railway/railway.ts no `mise run deploy:plan`/`deploy:apply`,
# não pelo servidor. Cada instância tem as suas.
# Domínio próprio (opcional; sem ele, use o gerado por `railway domain`). Também vira a BETTER_AUTH_URL.
# ZEROMETRO_DOMAIN=zerometro.exemplo.com
# Região do volume do SQLite (padrão: us-west2). Precisa bater com a de um volume que já existe.
# ZEROMETRO_VOLUME_REGION=us-west2
