# Copie para .env e preencha. Padrões de DATABASE_PATH, TZ e PORT ficam no mise.toml.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
MCP_TOKEN=

# Login (Better Auth + Google): https://console.cloud.google.com → Google Auth Platform → Clients
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do site (padrão: http://localhost:$PORT)
# BETTER_AUTH_URL=https://zerometro.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails convidados, separados por vírgula; o primeiro é o dono
ALLOWED_EMAILS=
